#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/etc/config/presence-detector.uc

start_service() {
    # Read interfaces from settings
    INTERFACES=$(ucode -e '
        const fs = require("fs");
        let settings = json(fs.readfile("/etc/config/presence-detector.settings.json"));
        for (let iface in settings.interfaces) print(iface, " ");
    ')

    # Check if we found interfaces
    if [ -z "$INTERFACES" ]; then
        logger -t presence-detector "ERROR: No interfaces defined in settings file."
        return
    fi

    # Start a watcher on each interface
    for iface in $INTERFACES; do
        procd_open_instance "$iface"
        procd_set_param command /usr/bin/ucode $PROG "$iface"
        procd_set_param respawn
        procd_set_param stderr 1
        procd_set_param stdout 1
        procd_close_instance
    done
}
