{
  "hass_url": "http://x.x.x.x:8123",
  "hass_token" : "home-assistant-long-lived access-token",
  "interfaces": ["hostapd.phy0-ap0","hostapd.phy1-ap0"],
  "filter_is_denylist": false,
  "filter": ["xx:xx:xx:xx:xx:x1", "xx:xx:xx:xx:xx:x2", "xx:xx:xx:xx:xx:x3"],
  "params": {
    "xx:xx:xx:xx:xx:xx": {"dev_id": "phone_1"},
    "xx:xx:xx:xx:xx:xx": {"dev_id": "phone_2"},
    "xx:xx:xx:xx:xx:xx": {"dev_id": "phone_3"}
  },

  "ap_name": "ap1",
  "location": "home",
  "away": "not_home",
  "fallback_sync_interval": 5,
  "source_type": "router",
  "debug": false
}
